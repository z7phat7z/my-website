function checkLogin(username, password, callback) {
  setTimeout(() => {
    if (username === "admin" && password === "123456") {
      callback(null, "Đăng nhập thành công!");
    } else {
      callback(new Error("Sai tên đăng nhập hoặc mật khẩu!"), null);
    }
  }, 1000);
}

function loginPromise(username, password) {
  return new Promise((resolve, reject) => {
    setTimeout(() => {
      if (username === "admin" && password === "123456") {
        resolve("Đăng nhập Promise thành công!");
      } else {
        reject(new Error("Sai tài khoản hoặc mật khẩu (Promise)!"));
      }
    }, 1000);
  });
}

loginPromise("admin", "123456")
  .then((res) => console.log("Câu 3 (Đúng):", res))
  .catch((err) => console.error("Câu 3 (Đúng) Lỗi:", err.message));

loginPromise("admin", "wrongpassword")
  .then((res) => console.log("Câu 3 (Sai):", res))
  .catch((err) => console.error("Câu 3 (Sai) Lỗi:", err.message));

function getUserPromise(id) {
  return new Promise((resolve, reject) => {
    setTimeout(() => {
      if (id === 1) {
        resolve({ id: 1, name: "Vũ Tấn Phát" });
      } else {
        reject(new Error("Không tìm thấy người dùng!"));
      }
    }, 1000);
  });
}

function getOrdersPromise(userId) {
  return new Promise((resolve, reject) => {
    setTimeout(() => {
      if (userId === 1) {
        resolve(["Đơn hàng #101", "Đơn hàng #102"]);
      } else {
        reject(new Error("Không có đơn hàng nào!"));
      }
    }, 1000);
  });
}

getUserPromise(1)
  .then((user) => {
    console.log("Câu 4 - User:", user);
    return getOrdersPromise(user.id);
  })
  .then((orders) => {
    console.log("Câu 4 - Orders:", orders);
  })
  .catch((err) => {
    console.error("Câu 4 Lỗi:", err.message);
  });

Promise.all([getUserPromise(1), getOrdersPromise(1)])
  .then(([user, orders]) => {
    console.log("Câu 5 - Promise.all thành công:");
    console.log("- User:", user);
    console.log("- Orders:", orders);
  })
  .catch((err) => {
    console.error("Câu 5 Lỗi:", err.message);
  });

async function loadAllDataParallel() {
  const userListDiv = document.getElementById("user-list");
  userListDiv.innerHTML =
    "<p>Đang tải dữ liệu đồng thời bằng Promise.all()...</p>";

  try {
    const [usersRes, postsRes] = await Promise.all([
      fetch("https://jsonplaceholder.typicode.com/users"),
      fetch("https://jsonplaceholder.typicode.com/posts?_limit=3"),
    ]);

    if (!usersRes.ok || !postsRes.ok) {
      throw new Error("Một trong các API bị lỗi!");
    }

    const users = await usersRes.json();
    const posts = await postsRes.json();

    let htmlContent = "<h2>Dữ liệu tải đồng thời (Promise.all):</h2>";

    htmlContent += "<h3>Danh sách Người dùng:</h3><ul>";
    users.forEach((user) => {
      htmlContent += `<li>${user.name} (${user.email})</li>`;
    });
    htmlContent += "</ul>";

    htmlContent += "<h3>Bài viết mẫu:</h3><ul>";
    posts.forEach((post) => {
      htmlContent += `<li><strong>${post.title}</strong></li>`;
    });
    htmlContent += "</ul>";

    userListDiv.innerHTML = htmlContent;
  } catch (error) {
    userListDiv.innerHTML = `<p style="color: red;">Lỗi khi tải dữ liệu song song: ${error.message}</p>`;
  }
}

loadAllDataParallel();

document
  .getElementById("post-form")
  .addEventListener("submit", async function (e) {
    e.preventDefault();

    const title = document.getElementById("post-title").value;
    const body = document.getElementById("post-body").value;
    const resultDiv = document.getElementById("post-result");

    try {
      const response = await fetch(
        "https://jsonplaceholder.typicode.com/posts",
        {
          method: "POST",
          headers: {
            "Content-Type": "application/json; charset=UTF-8",
          },
          body: JSON.stringify({
            title: title,
            body: body,
            userId: 1,
          }),
        },
      );

      if (!response.ok) throw new Error("Lỗi khi gửi dữ liệu!");

      const data = await response.json();

      resultDiv.innerHTML = `
      <div style="border: 1px solid green; padding: 10px; margin-top: 10px; background-color: #f0fff0; border-radius: 4px;">
        <p style="color: green; font-weight: bold; margin: 0 0 5px 0;">Tạo bài viết thành công!</p>
        <p style="margin: 3px 0;"><strong>ID:</strong> ${data.id}</p>
        <p style="margin: 3px 0;"><strong>Tiêu đề:</strong> ${data.title}</p>
        <p style="margin: 3px 0;"><strong>Nội dung:</strong> ${data.body}</p>
      </div>
    `;
    } catch (error) {
      resultDiv.innerHTML = `<p style="color: red;">Lỗi: ${error.message}</p>`;
    }
  });

const danhSachSanPham = [
  { id: 1, ten: "Áo thun Nam Cotton", gia: 150000 },
  { id: 2, ten: "Quần Jeans Slimfit", gia: 350000 },
  { id: 3, ten: "Giày Sneaker Thể thao", gia: 600000 },
  { id: 4, ten: "Balo Laptop Chống nước", gia: 450000 },
  { id: 5, ten: "Đồng hồ thông minh", gia: 850000 },
];

function renderProducts() {
  const productListEl = document.getElementById("product-list");
  if (!productListEl) return;

  productListEl.innerHTML = "";
  danhSachSanPham.forEach((sp) => {
    const card = document.createElement("div");
    card.style.cssText =
      "border: 1px solid #ddd; padding: 15px; border-radius: 6px; background: #fafafa;";
    card.innerHTML = `
      <h4 style="margin: 0 0 10px 0;">${sp.ten}</h4>
      <p style="color: #d9534f; font-weight: bold; margin: 0 0 10px 0;">${sp.gia.toLocaleString()} VNĐ</p>
      <button onclick="themVaoGio(${sp.id})" style="padding: 6px 12px; background: #28a745; color: white; border: none; border-radius: 4px; cursor: pointer;">Thêm vào giỏ</button>
    `;
    productListEl.appendChild(card);
  });
}

function themVaoGio(id) {
  const sp = danhSachSanPham.find((item) => item.id === id);
  if (!sp) return;

  let gioHang = JSON.parse(localStorage.getItem("gioHang")) || [];
  gioHang.push(sp);
  localStorage.setItem("gioHang", JSON.stringify(gioHang));
  capNhatHienThiGioHang();
  alert(`Đã thêm "${sp.ten}" vào giỏ hàng!`);
}

function capNhatHienThiGioHang() {
  const gioHang = JSON.parse(localStorage.getItem("gioHang")) || [];
  const soLuong = gioHang.length;
  const tongTien = gioHang.reduce((tong, item) => tong + item.gia, 0);

  const cartCountEl = document.getElementById("cart-count");
  const cartTotalEl = document.getElementById("cart-total");

  if (cartCountEl && cartTotalEl) {
    cartCountEl.textContent = soLuong;
    cartTotalEl.textContent = tongTien.toLocaleString();
  }
}

capNhatHienThiGioHang();
renderProducts();

const clearCartBtn = document.getElementById("clear-cart-btn");
if (clearCartBtn) {
  clearCartBtn.addEventListener("click", function () {
    localStorage.removeItem("gioHang");
    capNhatHienThiGioHang();
    alert("Đã xoá toàn bộ giỏ hàng!");
  });
}

// ==================== CÂU 4 (BT4) - BẮT ĐẦU ====================
let todos = JSON.parse(localStorage.getItem("todos")) || [];

const todoInput = document.getElementById("todo-input");
const addTodoBtn = document.getElementById("add-todo-btn");
const todoList = document.getElementById("todo-list");

function saveTodos() {
  localStorage.setItem("todos", JSON.stringify(todos));
}

function renderTodos() {
  if (!todoList) return;
  todoList.innerHTML = "";
  todos.forEach((todo, index) => {
    const li = document.createElement("li");
    li.style.cssText =
      "display: flex; justify-content: space-between; align-items: center; padding: 8px; border-bottom: 1px solid #eee;";

    const span = document.createElement("span");
    span.textContent = todo.text;
    if (todo.completed) {
      span.style.textDecoration = "line-through";
      span.style.color = "#888";
    }
    span.style.cursor = "pointer";
    span.onclick = () => toggleTodo(index);

    const deleteBtn = document.createElement("button");
    deleteBtn.textContent = "Xoá";
    deleteBtn.style.cssText =
      "background: #dc3545; color: white; border: none; padding: 4px 8px; border-radius: 4px; cursor: pointer;";
    deleteBtn.onclick = () => deleteTodo(index);

    li.appendChild(span);
    li.appendChild(deleteBtn);
    todoList.appendChild(li);
  });
}

function addTodo() {
  const text = todoInput.value.trim();
  if (!text) {
    alert("Vui lòng nhập nội dung công việc tìm kiếm!");
    return;
  }
  todos.push({ text: text, completed: false });
  saveTodos();
  todoInput.value = "";
  renderTodos();
}

function toggleTodo(index) {
  todos[index].completed = !todos[index].completed;
  saveTodos();
  renderTodos();
}

function deleteTodo(index) {
  todos.splice(index, 1);
  saveTodos();
  renderTodos();
}

async function fetchSampleTodos() {
  try {
    if (todos.length === 0) {
      const res = await fetch(
        "https://jsonplaceholder.typicode.com/todos?_limit=5",
      );
      if (!res.ok) throw new Error("Lỗi HTTP: " + res.status);
      const data = await res.json();
      data.forEach((item) => {
        todos.push({ text: item.title, completed: item.completed });
      });
      saveTodos();
      renderTodos();
    }
  } catch (error) {
    // Xử lý lỗi khi mất mạng hoặc API lỗi, ứng dụng vẫn dùng localStorage mà không crash
    console.error(
      "Không thể tải dữ liệu mẫu từ API, sử dụng dữ liệu offline:",
      error,
    );
  }
}

if (addTodoBtn) {
  addTodoBtn.addEventListener("click", addTodo);
}

if (todoInput) {
  todoInput.addEventListener("keypress", function (e) {
    if (e.key === "Enter") {
      addTodo();
    }
  });
}

renderTodos();
fetchSampleTodos();
